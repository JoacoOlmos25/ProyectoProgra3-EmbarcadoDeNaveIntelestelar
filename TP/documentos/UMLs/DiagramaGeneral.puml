@startuml
skinparam classAttributeIconSize 0
skinparam nodesep 70
skinparam ranksep 60

package "src.vista" {
    interface IVistaLogin
    class VentanaLogin
    interface IVistaPrincipal
    class VentanaPrincipal
    class PanelTablero
    VentanaLogin ..|> IVistaLogin
    VentanaPrincipal ..|> IVistaPrincipal
    VentanaPrincipal *-- PanelTablero
}

package "src.controlador" {
    class ControladorLogin
    class ControladorPrincipal
}

package "src.Usuario (DAO/DTO)" {
    class UsuarioService
    interface UsuarioDAO
    class UsuarioDAOJDBC
    class UsuarioDTO
    class ConexionBD
    UsuarioDAOJDBC ..|> UsuarioDAO
    UsuarioService --> UsuarioDAO
    UsuarioDAOJDBC ..> ConexionBD
    UsuarioService ..> UsuarioDTO
    UsuarioDAOJDBC ..> UsuarioDTO
}

package "src.AC (Fachada y Bitácora)" {
    class SistemaEstelar
    class Asistente
    class Bitacora
    SistemaEstelar o-- "*" Asistente
    Asistente *-- Bitacora
}

package "src.Misiones" {
    abstract class Mision
    class MisionFactory
    interface ObservadorMision
}

package "src.destinoytablero" {
    class Tablero
    class Destino
    interface Observador
}

package "src.nave y Elementos" {
    interface Comandable
    abstract class Nave
    class NaveFactory
    interface ElementoDelUniverso
    Nave ..|> Comandable
}

package "src.MotorWarp" {
    class MotorWarp
    interface MotorState
    MotorWarp *-- MotorState
}

package "src.Tripulacion" {
    abstract class Tripulante
    class TripulanteFactory
}

package "src.concurrencia" {
    class PlataformaDeCarga
    class ControladorVisor
    class VentanaVisorUniverso
}

ControladorLogin --> IVistaLogin
ControladorLogin --> UsuarioService
ControladorPrincipal --> IVistaPrincipal
ControladorPrincipal --> SistemaEstelar
ControladorPrincipal ..|> Observador
ControladorPrincipal ..|> ObservadorMision
VentanaPrincipal ..|> Observador

SistemaEstelar --> Tablero
SistemaEstelar --> Destino
SistemaEstelar --> NaveFactory
SistemaEstelar --> TripulanteFactory
SistemaEstelar --> MisionFactory

Mision --> Asistente
Mision --> Tablero
Mision --> Destino
Mision --> ObservadorMision

Asistente o-- Comandable
Nave *-- MotorWarp
Nave o-- "*" Tripulante
Nave ..> Bitacora
MotorWarp ..> Bitacora
Tablero o-- "*" ElementoDelUniverso

ControladorPrincipal ..> VentanaVisorUniverso : "abre visor"
ControladorVisor --> PlataformaDeCarga
ControladorVisor --> VentanaVisorUniverso
@enduml