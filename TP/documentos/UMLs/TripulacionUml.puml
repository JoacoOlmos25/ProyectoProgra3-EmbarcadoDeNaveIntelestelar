@startuml
skinparam classAttributeIconSize 0

package src.Tripulacion {
    abstract class Tripulante {
        # ident: String
        # antiguedad: int
        + getIdent(): String
        + getAntiguedad(): int
        + setAntiguedad(antiguedad: int)
        + esCapitan(): boolean
        + equals(obj: Object): boolean
        + hashCode(): int
        + {abstract} getRemu(): double
        + {abstract} toString(): String
    }

    class Alferez extends Tripulante {
        - base: double = 200
        + getRemu(): double
    }
    class Capitan extends Tripulante {
        - base: double = 1000
        + esCapitan(): boolean
        + getRemu(): double
    }
    class Consejero extends Tripulante {
        - base: double = 600
        - cantConsejos: int
        + nuevoConsejos(): void
        + getRemu(): double
    }
    class Teniente extends Tripulante {
        - base: double = 400
        + getRemu(): double
    }

    abstract class DecoratorTrip extends Tripulante {
        # tripu: Tripulante
        + DecoratorTrip(tripu: Tripulante)
        + getIdent(): String
        + getAntiguedad(): int
        + setAntiguedad(antiguedad: int)
        + esCapitan(): boolean
    }

    class Marciano extends DecoratorTrip {
        - {static} SUBSIDIO: int = 18
        + getRemu(): double
    }
    class Terricola extends DecoratorTrip {
        - {static} SUBSIDIO: int = 20
        + getRemu(): double
    }
    class Vulcano extends DecoratorTrip {
        - {static} SUBSIDIO: int = 30
        + getRemu(): double
    }

    class TripulanteFactory {
        + crearTripulante(cargo: String, origen: String, antiguedad: int, ident: String): Tripulante
    }

    DecoratorTrip o-- "1" Tripulante : "decora a"
    TripulanteFactory ..> Tripulante : "instancia y decora"
}
@enduml